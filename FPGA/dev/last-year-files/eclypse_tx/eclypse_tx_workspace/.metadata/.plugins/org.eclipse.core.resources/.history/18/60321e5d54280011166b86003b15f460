#include <stdio.h>
#include <math.h>
#include "xaxidma.h"
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"

#define DMA_DEV_ID      XPAR_AXIDMA_0_DEVICE_ID
#define TX_BUFFER_BASE  XPAR_PS7_DDR_0_S_AXI_BASEADDR + 0x01000000
#define MAX_PKT_LEN     4096       // size of DMA buffer in bytes
#define SAMPLES         (MAX_PKT_LEN / 4) // 4 bytes per sample (2 bytes per channel)

XAxiDma AxiDma;

int main()
{
    init_platform();

    XAxiDma_Config *CfgPtr;
    int Status, Index;
    u8 *TxBufferPtr = (u8 *)TX_BUFFER_BASE;

    xil_printf("Starting continuous sine wave output...\n\r");

    // Initialize memory to zeros
    for(Index = 0; Index < MAX_PKT_LEN; Index++){
        TxBufferPtr[Index] = 0x00;
    }

    // Initialize DMA
    CfgPtr = XAxiDma_LookupConfig(DMA_DEV_ID);
    if (!CfgPtr) {
        xil_printf("No config found for %d\r\n", DMA_DEV_ID);
        return XST_FAILURE;
    }

    Status = XAxiDma_CfgInitialize(&AxiDma, CfgPtr);
    if (Status != XST_SUCCESS) {
        xil_printf("DMA initialization failed %d\r\n", Status);
        return XST_FAILURE;
    }

    // Disable interrupts for simplicity
    XAxiDma_IntrDisable(&AxiDma, XAXIDMA_IRQ_ALL_MASK, XAXIDMA_DMA_TO_DEVICE);

    double Vref = 5;   // AWG Zmod low gain
    double Amp = 0.5;     // desired sine amplitude in V
    u16 neg_sign = 0x8000;

    // Fill DMA buffer with a sine wave
    for(Index = 0; Index < SAMPLES; Index++){
        double Vout = Amp * sin(2.0 * M_PI * Index / SAMPLES);
        double DAC_code_double = (Vout / Vref) * 8191;
        u16 DAC_code_u16, DAC_code;
        u8 upper_byte, lower_byte;

        if(DAC_code_double < 0){
            DAC_code_u16 = (u16)(-DAC_code_double);
            DAC_code = DAC_code_u16 << 2;
            DAC_code = ~DAC_code;
            DAC_code = DAC_code | neg_sign;
        } else {
            DAC_code_u16 = (u16)DAC_code_double;
            DAC_code = DAC_code_u16 << 2;
        }

        upper_byte = DAC_code >> 8;
        lower_byte = DAC_code & 0xFF;

        // Interleave channels: [ch2 lower, ch2 upper, ch1 lower, ch1 upper]
        TxBufferPtr[4*Index]     = lower_byte; // ch2
        TxBufferPtr[4*Index + 1] = upper_byte; // ch2
        TxBufferPtr[4*Index + 2] = lower_byte; // ch1
        TxBufferPtr[4*Index + 3] = upper_byte; // ch1
    }

    // Flush cache and reset DMA
    Xil_DCacheFlushRange((UINTPTR)TxBufferPtr, MAX_PKT_LEN);
    XAxiDma_Reset(&AxiDma);

    // Continuous streaming loop
    while(1){
        Status = XAxiDma_MM2Stransfer(&AxiDma, (UINTPTR)TxBufferPtr, MAX_PKT_LEN);
        if(Status != XST_SUCCESS){
            xil_printf("DMA transfer failed...\r\n");
            return XST_FAILURE;
        }

        // Wait until DMA is done
        while(XAxiDma_Busy(&AxiDma, XAXIDMA_DMA_TO_DEVICE));
    }

    cleanup_platform();
    return 0;
}
